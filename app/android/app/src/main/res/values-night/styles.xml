<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 다크 모드 시스템 테마라도 splash 는 항상 라이트 (흰 배경 + 로고).
         이전엔 Theme.Black 을 상속해서 NormalTheme.colorBackground 가 검정이
         되어 Flutter 첫 frame 직전에 검은 화면이 깜빡임. Theme.NoTitleBar
         (Light 계열) 로 통일 + windowBackground 명시. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
